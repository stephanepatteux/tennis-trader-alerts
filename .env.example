# Tennis Trader Alerts configuration.
# Copy to .env and fill in. NEVER commit your real .env — it is git-ignored.
# This repository contains no API keys — not even placeholders.

# --- Live Tennis API (ULTRA key required for real point-by-point push) -------
# Real-time push REQUIRES an ULTRA key — lower tiers cannot open the push feed
# (see the README for why). Get an Ultra key (affiliate link, code: botblog):
#   https://affiliates.livetennisapi.com/r/botblog
LIVE_TENNIS_API_KEY=

# API base URL (rarely needs changing). /ws-token is minted from here.
LIVE_TENNIS_API_BASE=https://api.livetennisapi.com/api/public/v1

# Seconds to wait when minting the WebSocket token / connecting.
LIVE_TENNIS_API_TIMEOUT=10

# When 1, fill missing win-probability with a local heuristic. Default 0: only
# the provider's Ultra model field is used (shown in Telegram when present).
MODEL_FALLBACK=0

# --- Telegram Bot API --------------------------------------------------------
# Create a bot with @BotFather and paste the token here. Never commit it.
TELEGRAM_BOT_TOKEN=

# Chat that receives alerts when no data/rules.json file is present.
# Get it by messaging @userinfobot or similar, or from getUpdates.
TELEGRAM_CHAT_ID=

# Optional label for the env-bootstrapped user.
TELEGRAM_USER_NAME=default

# Bot API host (override only for tests / a local mock).
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT=10

# --- Alert rules (used when data/rules.json is absent) -----------------------
# Triggers: 0-40, 15-40, 30-40, break-point (any BP), deuce, tiebreak
ALERT_TRIGGERS=0-40,15-40,30-40,break-point,deuce,tiebreak

# Filters. Empty = all. Comma-separated.
ALERT_TOURS=
ALERT_SURFACES=
ALERT_WATCHLIST=

# JSON rules file (preferred for multiple users). See data/rules.example.json.
RULES_PATH=data/rules.json

# --- Rate limiting (per Telegram chat_id) ------------------------------------
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_S=60

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
